{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "What the Cartographer window may do: show Save dialogs and write the files the user chose.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:allow-save",
    "dialog:allow-open",
    "fs:allow-write-file",
    { "identifier": "fs:scope", "allow": [{ "path": "**" }] }
  ]
}
